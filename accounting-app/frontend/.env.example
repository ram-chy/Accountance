# Accountance frontend — environment variables
#
# Copy this file to `.env.local` and adjust the value for your setup.
# `.env.local` is git-ignored; this example file is committed.

# Base URL of the Laravel API, including the `/api` prefix.
# Must be reachable from the browser (it is inlined into the client bundle).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
