# Accountance frontend — environment variables
#
# Copy this file to `.env.local` and adjust the value for your setup.
# `.env.local` is git-ignored; this example file is committed.

# Base URL of the Laravel API, including the `/api` prefix.
# Must be reachable from the browser (it is inlined into the client bundle).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Laravel origin used by the BFF (server-to-server). Prefer this in production so
# the value is not inlined into the client bundle; falls back to
# NEXT_PUBLIC_API_BASE_URL when unset.
API_BASE_URL=http://localhost:8000/api

# Secret used to encrypt the BFF session cookie (AES-256-GCM).
# REQUIRED in production (minimum 16 characters, high entropy, e.g. openssl rand -base64 32).
# A development-only fallback is used automatically when NODE_ENV !== "production".
SESSION_COOKIE_SECRET=

# Optional override for the session cookie name.
SESSION_COOKIE_NAME=accountance_session
